<script>
  document.getElementById('search_keywords').addEventListener('keyup', function() {
    let keywords = this.value;
    let resultDiv = document.querySelector('.show_here');

    // If the search input is empty, hide the div
    if (keywords.trim() === "") {
        resultDiv.style.display = 'none'; // Hide the div
        return; // Stop further execution
    }

    // If the search input is not empty, show the div
    resultDiv.style.display = 'block';

    // AJAX Request
    fetch("{{ url('search-courses') }}?keywords=" + keywords)
    .then(response => response.json())
    .then(data => {
        resultDiv.innerHTML = '';

        if (data.courses.length > 0) {
            data.courses.forEach(course => {
                resultDiv.innerHTML += `<a href="{{ url('course/') }}/${course.slug}">${course.name}</a>`;
            });
        } else {
            resultDiv.innerHTML = '<p>No courses found.</p>';
        }
    })
    .catch(error => console.error('Error:', error));
});

</script>

