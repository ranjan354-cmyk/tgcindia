<script>

/*---------------------end counter-----------------------*/
function updateTimernn() {
    // Local storage check: Agar pehle se future date set hai toh use karo, warna 2 din aage ka set karo
    let future = localStorage.getItem("futureTime");

    if (!future || new Date().getTime() > future) {
        future = new Date().getTime() + (2 * 24 * 60 * 60 * 1000); // Ab se 2 din baad ka time
        localStorage.setItem("futureTime", future); // Future time save karo
    }

    let now = new Date().getTime();
    let diff = future - now;

    let days = Math.floor(diff / (1000 * 60 * 60 * 24));
    let hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    let mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    let secs = Math.floor((diff % (1000 * 60)) / 1000);

    document.getElementById("end_timersnn").innerHTML =
        '<div>&nbsp;' + days + 'd <span>: </span></div>' +
        '<div>' + hours + 'h <span>: </span></div>' +
        '<div>' + mins + 'm <span>: </span></div>' +
        '<div>' + secs + 's <span></span>  <span class="modalopen ttd" data-toggle="modal" data-target="#offer_av" style="background:black;">GRAB NOW</span></div>';
}

// Har second update karega
setInterval(updateTimernn, 1000);

// Page load hone par ek baar turant update kare
updateTimernn();





</script>

